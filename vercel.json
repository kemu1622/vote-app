{
  "version": 2,
  "builds": [
    { "src": "api/config.js", "use": "@vercel/node" },
    { "src": "api/results.js", "use": "@vercel/node" },
    { "src": "api/vote.js", "use": "@vercel/node" },
    { "src": "api/token.js", "use": "@vercel/node" },
    { "src": "api/qrcode.js", "use": "@vercel/node" },
    { "src": "api/status.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/results", "dest": "/api/results.js" },
    { "src": "/api/vote", "dest": "/api/vote.js" },
    { "src": "/api/token", "dest": "/api/token.js" },
    { "src": "/api/qrcode", "dest": "/api/qrcode.js" },
    { "src": "/api/status", "dest": "/api/status.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/vote\\.html", "dest": "/public/vote.html" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" }
  ]
}
